# Server-only Vercel environment variables. Never prefix secrets with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
BLOB_READ_WRITE_TOKEN=
APP_URL=http://localhost:5173
APP_NAME=Two Souls

# At least 32 random characters. Generate a unique production value.
DATA_ENCRYPTION_KEY=

# The first API request creates or promotes these comma-separated owners.
ADMIN_EMAILS=owner@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Store owner

# Required for registration verification and password-reset delivery.
RESEND_API_KEY=
EMAIL_FROM=Two Souls <accounts@example.com>

# Optional Google sign-in. Callback: APP_URL/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMS MFA. Authenticator-app MFA works without these values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MFA_REQUIRED=false

# Optional Postgres pool cap per warm Function instance (1–10, default 5).
DATABASE_POOL_SIZE=5
